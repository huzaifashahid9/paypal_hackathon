# PayPal sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook ID from the same sandbox app (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# AI provider. OpenAI by default; any OpenAI-compatible endpoint works via OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=

# Postgres (Neon free tier). Leave empty to use a local embedded database in .pglite/
DATABASE_URL=

# Public URL of this app, used for PayPal return links and MCP URLs
APP_URL=http://localhost:3000

# Secret used to sign Agent Receipts (any long random string)
RECEIPT_SECRET=change-me

# Optional: AG Studio licence for the dashboard
AG_STUDIO=
